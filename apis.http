### 3) TEST /me/
GET {{baseUrl}}/me/
Authorization: Bearer {{accessToken}}

### 4) CREATE COMPLAINT
POST {{baseUrl}}/complaints/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "complaint_type": "INTERNET_DOWN",
  "description": "No internet since yesterday evening."
}

### 4) GET COMPLAINT
GET {{baseUrl}}/complaints/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "complaint_type": "INTERNET_DOWN",
  "description": "No internet since yesterday evening."
}